{
  "name": "go",
  "description": "Go development with linters",
  "features": {
    "ghcr.io/devcontainers/features/go:1": {
      "version": "latest"
    }
  },
  "extraDomains": [
    "proxy.golang.org",
    "sum.golang.org",
    "storage.googleapis.com"
  ],
  "cacheEnv": {
    "GOMODCACHE": "go/mod",
    "GOPATH": "go/path"
  }
}
