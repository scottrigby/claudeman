#!/bin/bash

# claudeman - Run Claude Code in a container with custom dependencies

set -e
trap 'echo "Error at line $LINENO"; exit 1' ERR

# Discover lib directory (Homebrew-aware, resolves symlinks)
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_PATH" ]; do
    SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    [[ $SCRIPT_PATH != /* ]] && SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"

LIB_DIR="${SCRIPT_DIR}/../share/claudeman/lib"  # Homebrew location
[ ! -d "$LIB_DIR" ] && LIB_DIR="${SCRIPT_DIR}/lib"  # Development/local install

# Set path to the devcontainer directory
CONTAINER_RAW_DIR="https://raw.githubusercontent.com/anthropics/claude-code/refs/heads/main/.devcontainer"

# Ensure local claude directories exist
function ensure_claude_dir {
    echo "Creating claude directories..."
    mkdir -p .claude
    touch .claude/.bash_history
}

# Find a .cf file by name, checking XDG config first, then bundled
function find_cf_file() {
    local name="$1"
    local xdg_config="${XDG_CONFIG_HOME:-$HOME/.config}"

    # Check XDG config first (user override)
    if [ -f "$xdg_config/claudeman/deps/${name}.cf" ]; then
        echo "$xdg_config/claudeman/deps/${name}.cf"
        return 0
    fi

    # Fall back to bundled
    if [ -f "$LIB_DIR/deps/${name}.cf" ]; then
        echo "$LIB_DIR/deps/${name}.cf"
        return 0
    fi

    return 1
}

# List available deps (from bundled + XDG config)
function list_available_deps() {
    local deps=()
    local xdg_config="${XDG_CONFIG_HOME:-$HOME/.config}"

    # Bundled deps
    if [ -d "$LIB_DIR/deps" ]; then
        for cf in "$LIB_DIR/deps"/*.cf; do
            [ -f "$cf" ] && deps+=("$(basename "$cf" .cf)")
        done
    fi

    # XDG config deps (may add new ones or override bundled)
    if [ -d "$xdg_config/claudeman/deps" ]; then
        for cf in "$xdg_config/claudeman/deps"/*.cf; do
            if [ -f "$cf" ]; then
                local name=$(basename "$cf" .cf)
                # Add if not already in list
                if [[ ! " ${deps[*]} " =~ " ${name} " ]]; then
                    deps+=("$name")
                fi
            fi
        done
    fi

    # Sort and output
    printf '%s\n' "${deps[@]}" | sort | tr '\n' ' ' | sed 's/ $//'
}

# Find a hook file by name, checking XDG config first, then bundled
function find_hook_file() {
    local name="$1"
    local xdg_config="${XDG_CONFIG_HOME:-$HOME/.config}"

    # Check XDG config first (user override)
    if [ -f "$xdg_config/claudeman/hooks/${name}.json" ]; then
        echo "$xdg_config/claudeman/hooks/${name}.json"
        return 0
    fi

    # Fall back to bundled
    if [ -f "$LIB_DIR/hooks/${name}.json" ]; then
        echo "$LIB_DIR/hooks/${name}.json"
        return 0
    fi

    return 1
}

# List available hooks (from bundled + XDG config)
function list_available_hooks() {
    local hooks=()
    local xdg_config="${XDG_CONFIG_HOME:-$HOME/.config}"

    # Bundled hooks
    if [ -d "$LIB_DIR/hooks" ]; then
        for json in "$LIB_DIR/hooks"/*.json; do
            [ -f "$json" ] && hooks+=("$(basename "$json" .json)")
        done
    fi

    # XDG config hooks (may add new ones or override bundled)
    if [ -d "$xdg_config/claudeman/hooks" ]; then
        for json in "$xdg_config/claudeman/hooks"/*.json; do
            if [ -f "$json" ]; then
                local name=$(basename "$json" .json)
                # Add if not already in list
                if [[ ! " ${hooks[*]} " =~ " ${name} " ]]; then
                    hooks+=("$name")
                fi
            fi
        done
    fi

    # Sort and output
    printf '%s\n' "${hooks[@]}" | sort | tr '\n' ' ' | sed 's/ $//'
}

# Generate image name:tag based on selected deps
function get_image_name() {
    local selected_deps="$1"
    local tag=""

    if [ -z "$selected_deps" ]; then
        tag="latest"
    elif [ "$selected_deps" = "all" ]; then
        tag="all"
    else
        # Sort deps alphabetically and join with hyphens
        tag=$(echo "$selected_deps" | tr ',' '\n' | sort | tr '\n' '-' | sed 's/-$//')
    fi

    # OCI spec: tag max 128 chars
    if [ ${#tag} -gt 128 ]; then
        tag="${tag:0:122}-TRUNC"
    fi

    echo "claudeman:$tag"
}

function build_container() {
    local selected_deps="$1"  # Comma-separated list, "all", or empty
    local image_name=$(get_image_name "$selected_deps")

    echo "Using timezone: $TIMEZONE"
    echo "Image: $image_name"
    TEMP_DIR=$(mktemp -d)

    # Download upstream Dockerfile and init script
    curl -s $CONTAINER_RAW_DIR/Dockerfile -o $TEMP_DIR/Dockerfile
    curl -s $CONTAINER_RAW_DIR/init-firewall.sh -o $TEMP_DIR/init-firewall.sh

    # Collect Containerfile fragments (.cf files)
    local cf_files=()

    # 1. Selected deps (from --deps argument)
    if [ -n "$selected_deps" ]; then
        if [ "$selected_deps" = "all" ]; then
            # Include all available deps
            for dep in $(list_available_deps); do
                local cf_path=$(find_cf_file "$dep")
                [ -n "$cf_path" ] && cf_files+=("$cf_path")
            done
        else
            # Include specific deps
            IFS=',' read -ra deps_array <<< "$selected_deps"
            for dep in "${deps_array[@]}"; do
                local cf_path=$(find_cf_file "$dep")
                if [ -n "$cf_path" ]; then
                    cf_files+=("$cf_path")
                else
                    echo "Warning: Dependency '$dep' not found"
                fi
            done
        fi
    fi

    # 2. Project local deps (always included)
    if [ -d ".claude/deps" ]; then
        for cf in ".claude/deps"/*.cf; do
            [ -f "$cf" ] && cf_files+=("$cf")
        done
    fi

    # Append all .cf files to Dockerfile
    if [ ${#cf_files[@]} -gt 0 ]; then
        echo ""
        echo "Appending Containerfile fragments:"
        for cf in "${cf_files[@]}"; do
            echo "  - $(basename "$cf")"
            echo "" >> $TEMP_DIR/Dockerfile
            echo "# --- $(basename "$cf") ---" >> $TEMP_DIR/Dockerfile
            cat "$cf" >> $TEMP_DIR/Dockerfile
        done

        # Ensure we end as node user (not root)
        echo "" >> $TEMP_DIR/Dockerfile
        echo "# Ensure final user is node" >> $TEMP_DIR/Dockerfile
        echo "USER node" >> $TEMP_DIR/Dockerfile
    fi

    podman build -t "$image_name" --build-arg TZ="$TIMEZONE" $TEMP_DIR
}

# Function to run container with common options
function run_container {
    local image_name="$1"
    local cmd="${2:-""}"  # Command to run (optional)

    # Common environment variables
    # Get terminal-specific ID for notifications based on TERM_PROGRAM
    local term_id=""

    case "${TERM_PROGRAM:-}" in
        ghostty)
            # Get terminal UUID (unique per tab/pane)
            term_id=$(osascript -e 'tell application "Ghostty" to get id of focused terminal of selected tab of front window' 2>/dev/null | sed 's/terminal id //')
            ;;
        Apple_Terminal)
            # Get window ID (unique per tab in Terminal.app)
            term_id=$(osascript -e 'tell application "Terminal" to id of front window' 2>/dev/null)
            ;;
        iTerm.app)
            # Get session unique ID
            term_id=$(osascript -e 'tell application "iTerm2" to get unique id of current session of current window' 2>/dev/null)
            ;;
        *)
            echo "Warning: Unsupported terminal '${TERM_PROGRAM:-unknown}'. Notifications may not focus correctly."
            ;;
    esac

    local env_vars=(
        "-e NODE_OPTIONS=--max-old-space-size=4096"
        "-e CLAUDE_CONFIG_DIR=/home/node/.claude"
        "-e POWERLEVEL9K_DISABLE_GITSTATUS=true"
        "-e TERM_PROGRAM=${TERM_PROGRAM:-}"
        "-e TERM_ID=$term_id"
    )

    # Common volume mounts
    local volumes=(
        "-v $(pwd)/.claude:/home/node/.claude"
        "-v $(pwd)/.claude/.bash_history:/commandhistory/.bash_history"
        "-v $(pwd):/workspace"
    )

    # Common local args
    local args=(
        "--cap-add=NET_ADMIN"
        "--cap-add=NET_RAW"
    )

    # Build the command
    podman run --rm -it ${env_vars[@]} ${volumes[@]} ${args[@]} "$image_name" ${cmd}
}

function usage {
    echo "Usage: claudeman [run|listen|deps|hooks|help] [options]"
    echo ""
    echo "Run from within a project directory"
    echo ""
    echo "Commands:"
    echo "  run [options] [--] [cmd]   Run an interactive container"
    echo "  listen [options]           Start the notification listener"
    echo "  deps                       List available dependencies"
    echo "  hooks                      List available hooks"
    echo "  help                       Displays help"
    echo ""
    echo "Run Options:"
    echo "  --deps=DEPS              Dependencies to install (comma-separated)"
    echo "                           Examples: --deps=go  --deps=go,python  --deps=all"
    echo "                           Default: none"
    echo "  --hooks=HOOKS            Hooks to enable (comma-separated)"
    echo "                           Examples: --hooks=prettier  --hooks=prettier,questions  --hooks=all"
    echo "                           Default: none"
    echo "  --                       Separator between options and command"
    echo ""
    echo "Listen Options:"
    echo "  -p, --port <port>        Listener port (default: 8080)"
    echo ""
    echo "Examples:"
    echo "  claudeman run                                  # Minimal (no deps, no hooks)"
    echo "  claudeman run --deps=go --hooks=prettier       # Go + prettier hook"
    echo "  claudeman run --hooks=prettier,q-notify       # Prettier + question notifications"
    echo "  claudeman run --deps=all --hooks=all           # Everything"
    echo "  claudeman run -- bash                          # Shell access"
    echo "  claudeman listen                               # Start notification listener"
    echo "  claudeman deps                                 # List available deps"
    echo "  claudeman hooks                                # List available hooks"
    echo ""
    echo "Dependencies:"
    echo "  Deps are Containerfile fragments (.cf files) installed at build time."
    echo "  Available: $(list_available_deps)"
    echo "  User overrides: ~/.config/claudeman/deps/*.cf"
    echo "  Project deps:   .claude/deps/*.cf (always included)"
    echo ""
    echo "Hooks:"
    echo "  Hooks are JSON files that configure Claude Code automation."
    echo "  Available: $(list_available_hooks)"
    echo "  User overrides: ~/.config/claudeman/hooks/*.json"
    echo ""
}

# Get current timezone in IANA format (e.g. "America/New_York")
TIMEZONE=$(readlink /etc/localtime | sed 's/.*zoneinfo\///')

# Check if no arguments are provided
if [ -z "${1:-}" ]; then
  usage
  exit 0
fi

command=$1
shift

case $command in
    run)
        echo "Running interactive container..."

        # Parse run flags (before --)
        SELECTED_DEPS=""
        SELECTED_HOOKS=""

        while [[ $# -gt 0 ]]; do
            case $1 in
                --deps=*)
                    SELECTED_DEPS="${1#--deps=}"
                    shift
                    ;;
                --hooks=*)
                    SELECTED_HOOKS="${1#--hooks=}"
                    shift
                    ;;
                --)
                    shift
                    break
                    ;;
                *)
                    break
                    ;;
            esac
        done

        ensure_claude_dir

        # Create claudeman directory structure
        mkdir -p .claude/claudeman

        # Collect selected hook files
        HOOK_FILES=""
        if [ -n "$SELECTED_HOOKS" ]; then
            if [ "$SELECTED_HOOKS" = "all" ]; then
                # Include all available hooks
                for hook in $(list_available_hooks); do
                    hook_path=$(find_hook_file "$hook")
                    [ -n "$hook_path" ] && HOOK_FILES="$HOOK_FILES $hook_path"
                done
            else
                # Include specific hooks
                IFS=',' read -ra hooks_array <<< "$SELECTED_HOOKS"
                for hook in "${hooks_array[@]}"; do
                    hook_path=$(find_hook_file "$hook")
                    if [ -n "$hook_path" ]; then
                        HOOK_FILES="$HOOK_FILES $hook_path"
                    else
                        echo "Warning: Hook '$hook' not found"
                    fi
                done
            fi
        fi

        # Validate hook dependencies
        if [ -n "$HOOK_FILES" ]; then
            # Build list of selected deps for comparison
            if [ "$SELECTED_DEPS" = "all" ]; then
                DEPS_LIST=$(list_available_deps | tr ' ' '\n')
            else
                DEPS_LIST=$(echo "$SELECTED_DEPS" | tr ',' '\n')
            fi

            # Check each hook's required deps
            for hook_path in $HOOK_FILES; do
                REQUIRED=$(node -e "const h=require('$hook_path'); (h.deps||[]).forEach(d=>console.log(d))")
                for req in $REQUIRED; do
                    if ! echo "$DEPS_LIST" | grep -q "^${req}$"; then
                        hook_name=$(basename "$hook_path" .json)
                        echo "Error: Hook '$hook_name' requires dep '$req'"
                        echo "  Add --deps=$req or remove --hooks=$hook_name"
                        exit 1
                    fi
                done
            done
        fi

        # Merge selected hooks into settings.json
        if [ -n "$HOOK_FILES" ]; then
            node "$LIB_DIR/merge-hooks.js" .claude/settings.json $HOOK_FILES
        else
            # No hooks selected - clear hooks from settings.json
            node "$LIB_DIR/merge-hooks.js" .claude/settings.json
        fi

        # Always copy claudeman files (get updates)
        if [ -f "$LIB_DIR/notify.js" ]; then
            cp "$LIB_DIR/notify.js" .claude/claudeman/notify.js
        fi

        if [ -f "$LIB_DIR/dedup.js" ]; then
            cp "$LIB_DIR/dedup.js" .claude/claudeman/dedup.js
            chmod +x .claude/claudeman/dedup.js
        fi

        if [ -f "$LIB_DIR/enforce-questions.sh" ]; then
            cp "$LIB_DIR/enforce-questions.sh" .claude/claudeman/enforce-questions.sh
            chmod +x .claude/claudeman/enforce-questions.sh
        fi

        # Build container and get image name
        IMAGE_NAME=$(get_image_name "$SELECTED_DEPS")
        build_container "$SELECTED_DEPS"

        [ $# -eq 0 ] && CMD="claude --dangerously-skip-permissions" || CMD="$@"
        run_container "$IMAGE_NAME" "$CMD"
        ;;
    listen)
        # Parse listen flags
        PORT=8080

        while [[ $# -gt 0 ]]; do
            case $1 in
                -p|--port)
                    PORT="$2"
                    shift 2
                    ;;
                *)
                    # Backward compatibility: positional port argument
                    if [[ "$1" =~ ^[0-9]+$ ]]; then
                        PORT="$1"
                        shift
                    else
                        echo "Error: Unknown option '$1'"
                        usage
                        exit 1
                    fi
                    ;;
            esac
        done

        if [ ! -f "$LIB_DIR/listener.js" ]; then
            echo "Error: listener.js not found at $LIB_DIR/listener.js"
            exit 1
        fi
        echo "Starting notification listener on port $PORT..."
        echo "Press Ctrl+C to stop"
        node "$LIB_DIR/listener.js" -p "$PORT"
        ;;
    deps)
        echo "Available dependencies:"
        echo ""
        for dep in $(list_available_deps); do
            cf_path=$(find_cf_file "$dep")
            if [ -n "$cf_path" ]; then
                # Extract first comment line as description
                desc=$(grep -m1 '^#' "$cf_path" | sed 's/^# *//')
                printf "  %-12s %s\n" "$dep" "$desc"
            fi
        done
        echo ""
        echo "Usage: claudeman run --deps=go,python"
        echo "       claudeman run --deps=all"
        ;;
    hooks)
        echo "Available hooks:"
        echo ""
        for hook in $(list_available_hooks); do
            hook_path=$(find_hook_file "$hook")
            if [ -n "$hook_path" ]; then
                # Extract description from JSON
                desc=$(node -e "console.log(require('$hook_path').description || '(no description)')")
                printf "  %-12s %s\n" "$hook" "$desc"
            fi
        done
        echo ""
        echo "Usage: claudeman run --hooks=prettier,q-notify"
        echo "       claudeman run --hooks=all"
        ;;
    help)
        usage
        ;;
    *)
        echo "Error: Unknown command '$command'"
        usage
        exit 1
        ;;
esac
