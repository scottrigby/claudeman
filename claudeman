#!/usr/bin/env node

/**
 * claudeman - Run Claude Code in devcontainers with profiles
 *
 * Wraps @devcontainers/cli with:
 * - Profile-based feature selection (app/user/project scopes)
 * - Feature discovery/search from containers.dev
 * - Dynamic environment variables (TERM_PROGRAM, TERM_ID)
 */

import { Command } from "commander";
import { VERSION } from "./helpers/settings.js";
import { featureCmd } from "./commands/feature.js";
import { profileCmd } from "./commands/profile.js";
import { domainCmd } from "./commands/domain.js";
import { initCmd } from "./commands/init.js";
import { runCmd } from "./commands/run.js";
import { migrateCmd } from "./commands/migrate.js";
import { listenCmd } from "./commands/listen.js";
import { cleanupCmd } from "./commands/cleanup.js";

const program = new Command();

program
  .name("claudeman")
  .description("Run Claude Code in devcontainers with profiles")
  .version(VERSION, "-v, --version")
  .enablePositionalOptions();

program.addCommand(featureCmd);
program.addCommand(profileCmd);
program.addCommand(domainCmd);
program.addCommand(initCmd);
program.addCommand(runCmd);
program.addCommand(migrateCmd);
program.addCommand(listenCmd);
program.addCommand(cleanupCmd);

program.parseAsync().catch((err) => {
  console.error(err.message);
  process.exit(1);
});
