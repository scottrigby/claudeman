{
  "description": "V1 hook command signatures and their v2 equivalents",
  "signatures": ["claudeman/dedup.js", "claudeman/notify.js"],
  "pluginReplacements": {
    "q-enforce": {
      "name": "claude-ask-questions",
      "marketplace": "scottrigby/claude-ask-questions",
      "description": "Enforce AskUserQuestion tool usage"
    }
  },
  "conversions": [
    {
      "match": "claudeman/notify.js.*-t\\s+question",
      "replace": "notify question \"Question ready\""
    },
    {
      "match": "claudeman/notify.js.*-t\\s+complete",
      "replace": "notify complete \"Task complete\""
    },
    {
      "match": "claudeman/notify.js.*-t\\s+idle",
      "replace": "notify idle \"Waiting for input\""
    },
    {
      "match": "claudeman/dedup.js.*notify.js.*-t\\s+question",
      "replace": "notify question \"Question ready\""
    },
    {
      "match": "claudeman/dedup.js.*notify.js.*-t\\s+complete",
      "replace": "notify complete \"Task complete\""
    }
  ]
}
